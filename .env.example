# ==========================================
# E-COMMERCE CUBA - Variables de Entorno
# ==========================================
#
# Copiar este archivo a .env para desarrollo local.
# NO commitear .env (ya está en .gitignore).
#
# Para producción en Vercel + Supabase, configurar
# en Vercel Dashboard > Settings > Environment Variables.
#

# --- Base de datos ---
# Desarrollo local (SQLite):
DATABASE_URL="file:./dev.db"

# Producción en Vercel (Supabase PostgreSQL):
# Usar session pooler (IPv4 + IPv6, puerto 6543):
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
# Conexión directa para migraciones (IPv6, solo Vercel):
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres?sslmode=require"

# --- NextAuth ---
# Local: openssl rand -base64 32
# Producción: generar uno NUEVO en Vercel (NO compartir secret entre entornos)
NEXTAUTH_SECRET=""
# URL base (cambiar en producción):
NEXTAUTH_URL="http://localhost:3000"

# --- Supabase Storage (para imágenes) ---
# Local: dejar vacío
# Producción: configurar en Vercel Dashboard
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
